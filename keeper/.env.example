# Copy to a file outside version control and load it with Node's --env-file flag.
ROBINHOOD_RPC_URL=https://your-verified-robinhood-chain-rpc.example
CHAIN_ID=4663
BUYBACK_VAULT_ADDRESS=
PONS_FEE_COLLECTOR_ADDRESS=
PONS_LOCKER_ADDRESS=0x736D76699C26D0d966744cAe304C000d471f7F35

# Required for live execution. For dry runs, omit this and set KEEPER_ADDRESS.
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=

# Fail-closed pins. The keeper stops if vault configuration differs.
ZAZU_TOKEN_ADDRESS=
# Deployed PonsV3Adapter address, not the underlying pons swap router.
DEX_ROUTER_ADDRESS=
WRAPPED_NATIVE_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
BUYBACK_DESTINATION=0x000000000000000000000000000000000000dEaD
# Must equal WRAPPED_NATIVE_ADDRESS for the pons WETH fee flow.
FEE_TOKEN_ADDRESS=
MIN_EXECUTION_AMOUNT=
MAX_EXECUTION_AMOUNT=
# Positive value, hard-capped by the vault at 500 bps.
MAX_SLIPPAGE_BPS=

# Authenticated Vercel quote route for the exact deployed pons v1 adapter.
KEEPER_QUOTE_API_URL=https://your-zazu-site.example/api/quote
KEEPER_QUOTE_API_KEY=
KEEPER_MAX_PRICE_IMPACT_BPS=
KEEPER_MAX_GAS_UNITS=
KEEPER_MAX_GAS_COST_WEI=

KEEPER_DRY_RUN=true
KEEPER_RUN_ONCE=false
KEEPER_POLL_INTERVAL_MS=60000
KEEPER_CONFIRMATIONS=2
KEEPER_QUOTE_TIMEOUT_MS=10000
KEEPER_QUOTE_VALIDITY_BUFFER_SECONDS=30
KEEPER_RECEIPT_TIMEOUT_MS=180000
KEEPER_RPC_RETRY_ATTEMPTS=5
KEEPER_RPC_RETRY_BASE_DELAY_MS=1000
KEEPER_RPC_RETRY_MAX_DELAY_MS=30000
KEEPER_LOCK_STALE_MS=180000
KEEPER_LOCK_FILE=
KEEPER_LOG_FILE=

# Supply these only for a live `npm run keeper:manual` after stopping automation.
# The manual entrypoint sets KEEPER_MANUAL_RUN=true and KEEPER_RUN_ONCE=true itself.
# KEEPER_MANUAL_ACK=AUTOMATION_STOPPED:4663:<CHECKSUMMED_BUYBACK_VAULT_ADDRESS>
# KEEPER_MANUAL_EXPECTED_NONCE=<LATEST_AND_PENDING_SIGNER_NONCE>
# KEEPER_MANUAL_REASON=<8_TO_200_CHARACTER_INCIDENT_NOTE>
