# One-time TUFF Pons V2 fee-claim + 0.0005 ETH buy-and-burn test.
# Railway: one replica, restart policy Never, start command npm run tuff:v2-test

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
TUFF_TOKEN_ADDRESS=0x9899CED1B23834d511e5f2998Fa1F7D5dB563668
TUFF_CURVE_ADDRESS=0x36FC810b7F267d1B27beAAeFD61fC2a2073D44C7
PONS_V2_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_V2_FEE_ESCROW_ADDRESS=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
TUFF_TEST_SIGNER_ADDRESS=0xCAfE59cb5466321617108a8838ed7d4F562Cc5c8
BUYBACK_DESTINATION=0x000000000000000000000000000000000000dEaD

TUFF_TEST_BUY_AMOUNT_WEI=500000000000000
TUFF_TEST_MAX_SLIPPAGE_BPS=100
TUFF_TEST_MAX_GAS_LIMIT=500000
TUFF_TEST_MAX_FEE_PER_GAS_WEI=100000000
TUFF_TEST_CONFIRMATIONS=2

# First deployment: no key and no writes.
TUFF_TEST_DRY_RUN=true

