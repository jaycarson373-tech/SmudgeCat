NEXT_PUBLIC_ZAZU_ADDRESS=
NEXT_PUBLIC_BUYBACK_VAULT_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_PONS_URL=https://pons.family/launchpad
NEXT_PUBLIC_DEX_URL=

# Server-only chain reads
ROBINHOOD_RPC_URL=
ROBINHOOD_EXPLORER_URL=
ROBINHOOD_NATIVE_SYMBOL=ETH
BUYBACK_VAULT_ADDRESS=
BUYBACK_VAULT_START_BLOCK=

# Foundry deployment. Never commit populated private keys.
CHAIN_ID=
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
# Mainnet INITIAL_OWNER must be a deployed multisig contract, not the deployer.
INITIAL_OWNER=
# New fixed supply is minted directly here. Defaults to INITIAL_OWNER.
TOKEN_RECIPIENT=
FIXED_SUPPLY=1000000000000000000000000000
ZAZU_TOKEN_ADDRESS=
# Address of the separately verified IDexAdapter, not raw underlying router.
DEX_ROUTER_ADDRESS=
WRAPPED_NATIVE_ADDRESS=
FEE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
BUYBACK_DESTINATION=
MIN_EXECUTION_AMOUNT=
MAX_EXECUTION_AMOUNT=
# Positive value, hard-capped by the vault at 500 bps.
MAX_SLIPPAGE_BPS=
CONFIGURATION_DELAY_SECONDS=172800

# Keeper fail-closed pins and safety ceilings
KEEPER_ADDRESS=
KEEPER_QUOTE_API_URL=
KEEPER_QUOTE_API_KEY=
KEEPER_MAX_PRICE_IMPACT_BPS=
KEEPER_MAX_GAS_UNITS=
KEEPER_MAX_GAS_COST_WEI=
KEEPER_DRY_RUN=true
KEEPER_RUN_ONCE=false
KEEPER_POLL_INTERVAL_MS=60000
KEEPER_CONFIRMATIONS=2
KEEPER_QUOTE_TIMEOUT_MS=10000
KEEPER_QUOTE_VALIDITY_BUFFER_SECONDS=30
KEEPER_RECEIPT_TIMEOUT_MS=180000
KEEPER_RPC_RETRY_ATTEMPTS=5
KEEPER_RPC_RETRY_BASE_DELAY_MS=1000
KEEPER_RPC_RETRY_MAX_DELAY_MS=30000
KEEPER_LOCK_STALE_MS=180000
KEEPER_LOCK_FILE=
KEEPER_LOG_FILE=
